# Copy this file to ".env" and fill in your values.
# Works with ANY OpenAI-compatible endpoint (your internal "codex", OpenAI, etc.)
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://your-internal-endpoint/v1
OPENAI_MODEL=gpt-4o-mini
# Embeddings model for RAG (Phase 4). Must be served by the same OpenAI-compatible endpoint.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Public deploy safety:
# Keep disabled until Prep Pack uses per-user/per-resume story-bank isolation.
PREP_PACK_ENABLED=false

# FastAPI CORS for the React frontend. Comma-separate production origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANON_COOKIE_SECURE=false

# Input guardrails for public/demo safety. Keep conservative unless you have
# auth, user isolation, rate limiting, and cost controls in place.
MAX_PDF_UPLOAD_BYTES=5000000
MAX_PDF_PAGES=8
MAX_PDF_TEXT_CHARS=80000
MAX_PROFILE_TEXT_CHARS=12000
MAX_JOB_DESCRIPTION_CHARS=30000
MAX_COACH_MESSAGE_CHARS=800
MAX_COACH_REPLY_CHARS=900
MAX_CAREER_PAGE_BYTES=750000
MAX_CAREER_PAGE_TEXT_CHARS=30000
CAREER_PAGE_TIMEOUT_SECONDS=15
CAREER_PAGE_MAX_REDIRECTS=3
ANON_SESSION_RETENTION_DAYS=14
ANON_DAILY_RESUME_LIMIT=3
ANON_DAILY_SCORE_LIMIT=10
ANON_DAILY_TAILOR_LIMIT=3
ANON_DAILY_COACH_LIMIT=30
ANON_DAILY_JOB_SAVE_LIMIT=20
ANON_SESSION_RATE_LIMIT_PER_MINUTE=20
ANON_IP_RATE_LIMIT_PER_MINUTE=60
ANON_IP_HASH_SALT=change-this-before-public-deploy

# --- Job search APIs (Phase 2) ---
# Adzuna: free signup at https://developer.adzuna.com/ -> gives an app id + key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# JSearch (Google-for-Jobs data) via RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your-rapidapi-key

# --- Free / local fallback (Ollama) ---
# 1. Install Ollama  2. run: ollama pull llama3.1  3. set the values below:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1
