# Copy this file to ".env" and fill in your values.
# Provider: NVIDIA NIM (Nemotron). Get a free API key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
# Per-task models (tiered for speed). FAST = the mechanical structured calls
# (score, keyword-classify, coach); TAILOR = the one quality-sensitive generation.
# Both fall back to NVIDIA_MODEL if unset. A smaller FAST model is ~2-3x quicker
# with no real accuracy loss on these JSON-shaped tasks.
NVIDIA_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_TAILOR=nvidia/nemotron-3-super-120b-a12b
# Tailoring re-tailor passes (each is one LLM call). 2 is plenty once the
# deterministic direct-keyword backfill runs; raise only if you need more polish.
TAILOR_MAX_PASSES=2
# Embeddings model for RAG (Phase 4 Prep Pack, optional/disabled by default).
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# LLM behavior (tuned for reliable structured JSON across all phases).
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
# Nemotron reasoning trace. Keep false: a visible "thinking" trace fights with
# strict structured output. Set true only for debugging/experiments.
LLM_ENABLE_THINKING=false

# Public deploy safety:
# Keep disabled until Prep Pack uses per-user/per-resume story-bank isolation.
PREP_PACK_ENABLED=false

# FastAPI CORS for the React frontend. Comma-separate production origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANON_COOKIE_SECURE=false

# Admin usage dashboard. Set a long random string to unlock GET /admin and
# GET /api/admin/usage (live visitor + feature counts). If unset, both fail
# closed (404) so usage stats are never public. On Hugging Face, set this as a
# Space *secret*, not a plain variable.
ADMIN_TOKEN=

# Runtime storage. Local native runs default to ./db/job-tracker.db and ./data.
# Docker/Compose sets these to /home/user/app/runtime/... so a volume can persist
# SQLite, uploads, profile text, and generated tailored PDFs without hiding code.
# JOB_AGENT_DB_PATH=/home/user/app/runtime/db/job-tracker.db
# JOB_AGENT_DATA_DIR=/home/user/app/runtime/data

# Input guardrails for public/demo safety. Keep conservative unless you have
# auth, user isolation, rate limiting, and cost controls in place.
MAX_PDF_UPLOAD_BYTES=5000000
MAX_PDF_PAGES=8
MAX_PDF_TEXT_CHARS=80000
MAX_PROFILE_TEXT_CHARS=12000
MAX_JOB_DESCRIPTION_CHARS=30000
MAX_COACH_MESSAGE_CHARS=800
MAX_COACH_REPLY_CHARS=900
MAX_CAREER_PAGE_BYTES=750000
MAX_CAREER_PAGE_TEXT_CHARS=30000
CAREER_PAGE_TIMEOUT_SECONDS=15
CAREER_PAGE_MAX_REDIRECTS=3
ANON_SESSION_RETENTION_DAYS=14
ANON_DAILY_RESUME_LIMIT=3
ANON_DAILY_SCORE_LIMIT=10
ANON_DAILY_TAILOR_LIMIT=3
ANON_DAILY_COACH_LIMIT=30
ANON_DAILY_JOB_SAVE_LIMIT=20
ANON_SESSION_RATE_LIMIT_PER_MINUTE=20
ANON_IP_RATE_LIMIT_PER_MINUTE=60
ANON_IP_HASH_SALT=change-this-before-public-deploy

# --- Job search APIs (Phase 2) ---
# Adzuna: free signup at https://developer.adzuna.com/ -> gives an app id + key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# JSearch (Google-for-Jobs data) via RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your-rapidapi-key

# --- Alternative model on the same NVIDIA endpoint ---
# Any NVIDIA-hosted model that supports structured output / tool calling works.
# Just change NVIDIA_MODEL above, e.g.:
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
